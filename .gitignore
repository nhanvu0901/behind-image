# Environments, caches, scratch
.venv*/
venv_align/
hf_cache/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
._*
.scratch/
.env
.env.*

# Source books and anything derived from their content (copyrighted, private)
books/
library/books/
library/clean_text/
library/restored/
library/text_audit/
library/cache/
library/artworks.json
library/unparsed.json
library/dossiers/
projects/*/source/

# Reference channel media
research_media/

# Heavy media and render outputs
*.mp4
*.mov
*.m4a
*.wav
*.mp3
*.tgz
*.zip
*.pdf
demo_runs/**/assets/
demo_runs/**/voice/
demo_runs/**/ref/server/
projects/*/media/
projects/*/audio/
projects/*/cache/
projects/*/history/

# Keep the technique previews: the thumbnails (jpg) and the clips (mp4, a few hundred KB each). The server gets them by `git pull`.
!style/gae/previews/*.mp4

# Other agents' benchmark outputs (not part of the pipeline)
demo_runs/antigravity/
demo_runs/codex/
!.env.example

# Machine-local settings and run state (owner model choices, voice timing stats, snapshots)
run/

# Runtime folders of a deployed copy (the server is a git checkout; these never belong to the repository)
/logs/
/cache/
/_deploy/
