 100.94}, {"w": "plays", "s": 100.98, "e": 101.32}, {"w": "with", "s": 101.36, "e": 101.66}, {"w": "the", "s": 101.7, "e": 101.96}, {"w": "viewer,", "s": 102.0, "e": 102.37}, {"w": "van", "s": 102.59, "e": 102.86}, {"w": "Eyck", "s": 102.9, "e": 103.2}, {"w": "instead", "s": 103.24, "e": 103.64}, {"w": "records", "s": 103.68, "e": 104.09}, {"w": "every", "s": 104.13, "e": 104.46}, {"w": "single", "s": 104.5, "e": 104.87}, {"w": "detail.", "s": 104.91, "e": 105.28}, {"w": "Even", "s": 105.77, "e": 106.07}, {"w": "the", "s": 106.11, "e": 106.38}, {"w": "wooden", "s": 106.42, "e": 106.79}, {"w": "clogs", "s": 106.83, "e": 107.16}, {"w": "by", "s": 107.2, "e": 107.43}, {"w": "the", "s": 107.47, "e": 107.74}, {"w": "door", "s": 107.78, "e": 108.08}, {"w": "tell", "s": 108.12, "e": 108.42}, {"w": "us", "s": 108.46, "e": 108.69}, {"w": "that", "s": 108.73, "e": 109.03}, {"w": "the", "s": 109.07, "e": 109.33}, {"w": "ground", "s": 109.37, "e": 109.74}, {"w": "is", "s": 109.78, "e": 110.01}, {"w": "holy.", "s": 110.05, "e": 110.35}, {"w": "Today", "s": 110.84, "e": 111.18}, {"w": "the", "s": 111.22, "e": 111.48}, {"w": "painting", "s": 111.52, "e": 111.96}, {"w": "hangs", "s": 112.0, "e": 112.34}, {"w": "in", "s": 112.38, "e": 112.61}, {"w": "London,", "s": 112.65, "e": 113.02}, {"w": "and", "s": 113.24, "e": 113.5}, {"w": "it", "s": 113.54, "e": 113.77}, {"w": "still", "s": 113.81, "e": 114.15}, {"w": "invites", "s": 114.19, "e": 114.59}, {"w": "us", "s": 114.63, "e": 114.86}, {"w": "to", "s": 114.9, "e": 115.13}, {"w": "look", "s": 115.17, "e": 115.47}, {"w": "again,", "s": 115.51, "e": 115.85}, {"w": "and", "s": 116.07, "e": 116.33}, {"w": "again.", "s": 116.37, "e": 116.71}], "beats": [{"chapter": "OPENING", "text": "The Arnolfini Portrait is the most puzzling painting in the National Gallery.", "start": 0.35, "end": 4.99, "w0": 0, "w1": 11}, {"chapter": "OPENING", "text": "Painted in Bruges in fourteen thirty four, it shows a wealthy couple in a quiet room.", "start": 5.48, "end": 11.2, "w0": 12, "w1": 27}, {"chapter": "OPENING", "text": "Nothing in it is accidental, and every object seems to carry a hidden meaning.", "start": 11.68, "end": 16.83, "w0": 28, "w1": 41}, {"chapter": "OPENING", "text": "Let us begin with the whole picture, and then we will look closer.", "start": 17.32, "end": 21.88, "w0": 42, "w1": 54}, {"chapter": "THE_MIRROR", "text": "The man raises his right hand, while his left hand gently holds the hand of his wife.", "start": 22.37, "end": 28.25, "w0": 55, "w1": 71}, {"chapter": "THE_MIRROR", "text": "Her green dress is made from many metres of wool, a sign of quiet wealth.", "start": 28.74, "end": 33.88, "w0": 72, "w1": 86}, {"chapter": "THE_MIRROR", "text": "Notice the round mirror on the back wall, because it changes everything.", "start": 34.37, "end": 38.98, "w0": 87, "w1": 98}, {"chapter": "THE_MIRROR", "text": "Inside its tiny convex glass we see the room reflected from behind, with two more figures at the door.", "start": 39.47, "end": 46.28, "w0": 99, "w1": 117}, {"chapter": "THE_MIRROR", "text": "One of them may be the painter himself, and above the mirror he wrote a famous sentence.", "start": 46.77, "end": 52.76, "w0": 118, "w1": 134}, {"chapter": "THE_MIRROR", "text": "Jan van Eyck was here, fourteen thirty four, and he wanted us to know it.", "start": 53.25, "end": 58.53, "w0": 135, "w1": 149}, {"chapter": "LIGHT_AND_PAINT", "text": "Chapter two follows the light, because the window on the left feeds the whole scene.", "start": 59.02, "end": 64.54, "w0": 150, "w1": 164}, {"chapter": "LIGHT_AND_PAINT", "text": "Oil paint was new, and van Eyck built the surface in thin glazes, layer upon layer.", "start": 65.03, "end": 70.82, "w0": 165, "w1": 180}, {"chapter": "LIGHT_AND_PAINT", "text": "X-ray images show that the artist changed the position of the hands several times.", "start": 71.31, "end": 76.45, "w0": 181, "w1": 194}, {"chapter": "LIGHT_AND_PAINT", "text": "Look at the single candle burning in the chandelier, even in broad daylight.", "start": 76.94, "end": 81.85, "w0": 195, "w1": 207}, {"chapter": "LIGHT_AND_PAINT", "text": "Some scholars read it as the eye of God, others as a wedding custom.", "start": 82.34, "end": 87.14, "w0": 208, "w1": 221}, {"chapter": "LIGHT_AND_PAINT", "text": "The little dog in the foreground is a symbol of loyalty, or perhaps only of status.", "start": 87.63, "end": 93.28, "w0": 222, "w1": 237}, {"chapter": "LIGHT_AND_PAINT", "text": "Compare this room with a later interior by Velazquez, and the difference in ambition appears.", "start": 93.77, "end": 99.6, "w0": 238, "w1": 252}, {"chapter": "LIGHT_AND_PAINT", "text": "Where Velazquez plays with the viewer, van Eyck instead records every single detail.", "start": 100.09, "end": 105.28, "w0": 253, "w1": 265}, {"chapter": "LIGHT_AND_PAINT", "text": "Even the wooden clogs by the door tell us that the ground is holy.", "start": 105.77, "end": 110.35, "w0": 266, "w1": 279}, {"chapter": "LIGHT_AND_PAINT", "text": "Today the painting hangs in London, and it still invites us to look again, and again.", "start": 110.84, "end": 116.71, "w0": 280, "w1": 295}], "chapters": [{"name": "OPENING", "start": 0.0, "end": 22.37}, {"name": "THE_MIRROR", "start": 22.37, "end": 59.02}, {"name": "LIGHT_AND_PAINT", "start": 59.02, "end": 118.2}]}