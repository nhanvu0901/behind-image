{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "GAE techniques registry",
 "type": "object",
 "required": [
  "techniques"
 ],
 "properties": {
  "version": {
   "type": "integer"
  },
  "generated": {
   "type": "string"
  },
  "note": {
   "type": "string"
  },
  "techniques": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "$ref": "#/$defs/technique"
   }
  }
 },
 "$defs": {
  "technique": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "key",
    "name",
    "label_vi",
    "category",
    "kind",
    "intents",
    "description",
    "usage_rule",
    "channel_usage",
    "offered",
    "slots",
    "params",
    "timing",
    "engine",
    "preview",
    "evidence"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^([A-Z]+-\\d{2}|X-[A-Z]+-\\d{2}|ID-[A-Z]+-\\d{2}|(MAP|KEY|TIME|NUM|TREE|STATE|DOC)-\\d{2})$"
    },
    "key": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "label_vi": {
     "type": "string",
     "minLength": 1
    },
    "category": {
     "enum": [
      "camera",
      "transition",
      "layout",
      "highlight",
      "annotation",
      "text",
      "static",
      "diagram",
      "compare",
      "footage",
      "card",
      "shorts"
     ]
    },
    "kind": {
     "enum": [
      "base",
      "overlay",
      "transition",
      "card"
     ]
    },
    "intents": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "enum": [
       "establish",
       "explore",
       "point_at",
       "isolate",
       "reveal",
       "compare",
       "context",
       "quantify",
       "explain_mechanism",
       "quote",
       "structure",
       "transition"
      ]
     }
    },
    "description": {
     "type": "string",
     "minLength": 10
    },
    "usage_rule": {
     "type": [
      "string",
      "null"
     ]
    },
    "channel_usage": {
     "enum": [
      "core",
      "occasional",
      "rare",
      "shorts_only",
      "other_series"
     ]
    },
    "offered": {
     "type": "boolean",
     "description": "true: a model that writes a storyboard is shown this technique (inputs/techniques.md) and may use it; false: it is hidden from the models (never deleted: stored storyboards that use it stay valid and draw as before). Decided by the catalogue pass of 2026-11-20."
    },
    "hidden_reason": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "code",
      "use",
      "note"
     ],
     "description": "a hidden technique says why: program (the program writes it), other_format (for Shorts, another series or a one-episode effect), replaced (a newer technique does the job: `use` names it), no_material (needs material the pipeline never supplies: `note` names it), redundant (an offered technique does the job: `use` names it)",
     "properties": {
      "code": {
       "enum": [
        "program",
        "other_format",
        "replaced",
        "no_material",
        "redundant"
       ]
      },
      "use": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "the offered techniques to use instead (empty: none, or leave it out)"
      },
      "note": {
       "type": "string",
       "minLength": 10,
       "description": "one plain sentence that says what the model does instead"
      }
     }
    },
    "serves": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "enum": [
       "detail",
       "whole",
       "idea",
       "outside",
       "compare",
       "journey",
       "dates",
       "figure",
       "inscription",
       "construction",
       "relations"
      ]
     },
     "description": "offered only: the kinds of line (`kinds` of a beat in inputs/beats.json) the technique serves; the first one is where inputs/techniques.md lists it"
    },
    "use_when": {
     "type": "string",
     "minLength": 20,
     "description": "offered only: the sentence that calls for the technique, as exactly as it can be said"
    },
    "needs": {
     "type": "string",
     "minLength": 20,
     "description": "offered only: what must exist: which pictures, which data from the narration"
    },
    "never_when": {
     "type": "string",
     "minLength": 20,
     "description": "offered only: the cases in which it must not be used"
    },
    "example": {
     "type": "string",
     "minLength": 20,
     "description": "offered only: one real sentence with its line id from the two finished narrations, or `No sentence in the two narrations calls for it.`"
    },
    "slots": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "name",
       "type",
       "required",
       "region"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "type": {
        "enum": [
         "image",
         "video",
         "text"
        ]
       },
       "required": {
        "type": "boolean"
       },
       "region": {
        "type": "boolean"
       }
      }
     }
    },
    "params": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "name",
       "type",
       "default",
       "min",
       "max",
       "unit",
       "values",
       "measured"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "type": {
        "enum": [
         "number",
         "enum",
         "bool",
         "string",
         "color",
         "text",
         "point",
         "box",
         "camera",
         "asset",
         "points",
         "lines",
         "items",
         "at"
        ],
        "description": "items: a list of records whose fields the entry declares in `fields` (contract docs/design/2026-11-18-explainer-components.md section 3); at: one moment, seconds from the start of the element (min and max in seconds) or a word anchor"
       },
       "default": {},
       "min": {
        "type": [
         "number",
         "null"
        ]
       },
       "max": {
        "type": [
         "number",
         "null"
        ]
       },
       "unit": {
        "type": [
         "string",
         "null"
        ]
       },
       "values": {
        "type": [
         "array",
         "null"
        ],
        "items": {
         "type": "string"
        }
       },
       "measured": {
        "oneOf": [
         {
          "type": "null"
         },
         {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "value",
           "source"
          ],
          "properties": {
           "value": {},
           "source": {
            "type": "string",
            "minLength": 1
           }
          }
         }
        ]
       },
       "required": {
        "type": "boolean",
        "description": "true: the param must be present and not null (its default is null because there is no sensible fixed value; default_params fills it)"
       },
       "pattern": {
        "type": "string",
        "description": "string/text/lines params: a regular expression the whole value (each item for lines, line breaks collapsed) must match"
       },
       "pattern_hint": {
        "type": "string",
        "description": "one Vietnamese sentence that says what to type; shown under the field and as the validation message"
       },
       "min_items": {
        "type": "integer",
        "minimum": 0,
        "description": "points/lines/items params: fewest items"
       },
       "max_items": {
        "type": "integer",
        "minimum": 0,
        "description": "points/lines/items params: most items"
       },
       "numeric_only": {
        "type": "boolean",
        "description": "point/points params: only [x, y] numbers are accepted, a region name is not (the coordinates are canvas pixels or the renderer does not look regions up)"
       },
       "fields": {
        "type": "array",
        "description": "items params: the fields of one record",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "name",
          "type",
          "required",
          "default",
          "min",
          "max",
          "values"
         ],
         "properties": {
          "name": {
           "type": "string",
           "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
           "enum": [
            "string",
            "number",
            "enum",
            "bool",
            "lonlat",
            "ref",
            "at"
           ]
          },
          "required": {
           "type": "boolean"
          },
          "default": {},
          "min": {
           "type": [
            "number",
            "null"
           ]
          },
          "max": {
           "type": [
            "number",
            "null"
           ]
          },
          "unit": {
           "type": [
            "string",
            "null"
           ]
          },
          "values": {
           "type": [
            "array",
            "null"
           ],
           "items": {
            "type": "string"
           }
          },
          "pattern": {
           "type": "string",
           "description": "string fields: a regular expression the whole value must match"
          },
          "pattern_hint": {
           "type": "string",
           "description": "one Vietnamese sentence that says what to type"
          }
         }
        }
       }
      },
      "allOf": [
       {
        "if": {
         "properties": {
          "type": {
           "const": "enum"
          }
         }
        },
        "then": {
         "properties": {
          "values": {
           "type": "array",
           "minItems": 2
          }
         }
        }
       }
      ]
     }
    },
    "timing": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "default_s",
      "min_s",
      "max_s",
      "anchor"
     ],
     "properties": {
      "default_s": {
       "type": [
        "number",
        "null"
       ]
      },
      "min_s": {
       "type": [
        "number",
        "null"
       ]
      },
      "max_s": {
       "type": [
        "number",
        "null"
       ]
      },
      "anchor": {
       "enum": [
        "shot_start",
        "word",
        "none"
       ]
      }
     }
    },
    "engine": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "available",
      "impl",
      "reason",
      "notes"
     ],
     "properties": {
      "status": {
       "enum": [
        "done",
        "partial",
        "missing"
       ]
      },
      "impl": {
       "type": [
        "string",
        "null"
       ]
      },
      "notes": {
       "type": [
        "string",
        "null"
       ]
      },
      "available": {
       "type": "boolean",
       "description": "true only when the new engine (bti.engine) can render this technique today"
      },
      "reason": {
       "type": [
        "string",
        "null"
       ],
       "description": "why the technique is not available (shown greyed out in the gallery); null when available"
      }
     },
     "allOf": [
      {
       "if": {
        "properties": {
         "status": {
          "enum": [
           "partial",
           "missing"
          ]
         }
        }
       },
       "then": {
        "properties": {
         "notes": {
          "type": "string"
         }
        }
       }
      },
      {
       "if": {
        "properties": {
         "available": {
          "const": true
         }
        }
       },
       "then": {
        "properties": {
         "impl": {
          "type": "string",
          "pattern": "^bti\\.engine\\."
         }
        }
       }
      },
      {
       "if": {
        "properties": {
         "available": {
          "const": false
         }
        }
       },
       "then": {
        "properties": {
         "reason": {
          "type": "string",
          "minLength": 5
         }
        }
       }
      }
     ]
    },
    "preview": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "reel_start",
        "reel_end",
        "clip",
        "thumb"
       ],
       "properties": {
        "reel_start": {
         "type": "number"
        },
        "reel_end": {
         "type": "number"
        },
        "clip": {
         "type": "string"
        },
        "thumb": {
         "type": "string"
        }
       }
      }
     ]
    },
    "evidence": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "offered": {
        "const": true
       }
      },
      "required": [
       "offered"
      ]
     },
     "then": {
      "required": [
       "serves",
       "use_when",
       "needs",
       "never_when",
       "example"
      ]
     },
     "else": {
      "required": [
       "hidden_reason"
      ]
     }
    }
   ]
  }
 }
}
